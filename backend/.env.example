# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bioplatform:bioplatform@postgres:5432/bioplatform

# ── Celery / Redis ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Backend selection ─────────────────────────────────────────────────────
STORAGE_BACKEND=local            # local | s3
NEXTFLOW_BACKEND=mock            # mock | local | awsbatch
NEXTFLOW_PROFILE=docker          # docker | singularity (local mode only)
SNAKEMAKE_BACKEND=mock           # mock | local | awsbatch
BIOSCRIPT_BACKEND=mock           # mock | local | awsbatch
CUSTOM_BACKEND=mock              # mock | awsbatch

# ── Storage ───────────────────────────────────────────────────────────────
UPLOADS_DIR=/uploads
PUBLIC_BASE_URL=http://localhost:8000

# ── AWS ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PRESIGN_EXPIRY=900

# ── AWS Batch ─────────────────────────────────────────────────────────────
BATCH_JOB_QUEUE=bioplatform-default
BATCH_JOB_ROLE_ARN=
SNAKEMAKE_BATCH_QUEUE=
SNAKEMAKE_CONTAINER_IMAGE=snakemake/snakemake:v8.20.0
BIOSCRIPT_DOCKER_IMAGE=bioplatform/tools:latest

# ── Assessment pipeline ───────────────────────────────────────────────────
ASSESSMENT_GENOME=hg38           # hg19 | hg38
OMIM_API_KEY=                    # free academic key at omim.org/api
ORPHANET_API_KEY=                # free key at orphacode.org

# ── Auth / JWT ────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=10080         # 7 days

# ── MFA (TOTP) ────────────────────────────────────────────────────────────
MFA_ISSUER=BioplatformMD

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Stripe (global payments) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=               # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=           # whsec_...
APP_BASE_URL=http://localhost:5173

# ── iyzico (Turkish market payments) ─────────────────────────────────────
IYZICO_API_KEY=                  # from iyzico merchant panel
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox.iyzipay.com   # use https://api.iyzipay.com in prod
IYZICO_USD_TO_TRY_RATE=33.0     # update regularly or integrate a live FX feed

# ── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=                      # https://xxx@sentry.io/yyy  (leave blank to disable)

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=log               # log | ses | smtp
EMAIL_FROM=noreply@bioplatform.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SES_REGION=                      # defaults to AWS_REGION

# ── Runtime ───────────────────────────────────────────────────────────────
DEBUG=true
